{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fam-tung-lam/ptlam-skills/tools/plugin-compiler/schemas/plugin.schema.json",
  "title": "PTLam plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plugin",
    "marketplace",
    "categories",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plugin": {
      "$ref": "#/$defs/pluginMetadata"
    },
    "marketplace": {
      "$ref": "#/$defs/marketplace"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skill"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "markdownTableText": {
      "type": "string",
      "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}\\p{Cs}]+$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "email": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "url": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "pluginMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "description",
        "author",
        "homepage",
        "repository",
        "license",
        "keywords"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "author": {
          "$ref": "#/$defs/author"
        },
        "homepage": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "repository": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "license": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "keywords": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "plugin_description",
        "category",
        "keywords"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "plugin_description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "category": {
          "$ref": "#/$defs/identifier"
        },
        "keywords": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/markdownTableText"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "kind", "summary", "required_skill_ids"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": ["product", "test"]
        },
        "summary": {
          "$ref": "#/$defs/markdownTableText"
        },
        "required_skill_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  }
}
