{
  "name": "ptlam-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pham Tung Lam's portable agent skill catalog.",
  "scripts": {
    "plugin:check": "tsx tools/plugin-compiler/plugin-compiler-cli.ts check",
    "plugin:compile": "tsx tools/plugin-compiler/plugin-compiler-cli.ts generate",
    "plugin:validate": "tsx tools/plugin-compiler/plugin-compiler-cli.ts validate",
    "plugin:verify": "npm run plugin:validate && npm run plugin:check",
    "code:check": "biome check .",
    "code:format": "biome check --write .",
    "code:typecheck": "tsc --project tsconfig.json",
    "markdown:check": "npm run markdown:format:check && npm run markdown:lint",
    "markdown:format": "prettier --write \"**/*.{md,mdx}\"",
    "markdown:format:check": "prettier --check \"**/*.{md,mdx}\"",
    "markdown:lint": "markdownlint-cli2",
    "markdown:lint:fix": "markdownlint-cli2 --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "markdownlint-cli2": "0.23.2",
    "mdast-util-from-markdown": "2.0.3",
    "prettier": "3.9.6",
    "string-width": "8.2.1",
    "tsx": "4.23.7",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
