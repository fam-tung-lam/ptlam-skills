{
  "name": "ptlam-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Pham Tung Lam's portable agent skill catalog.",
  "scripts": {
    "catalog:check": "node tools/plugin-compiler/plugin-compiler-cli.mjs check",
    "catalog:generate": "node tools/plugin-compiler/plugin-compiler-cli.mjs generate",
    "catalog:validate": "node tools/plugin-compiler/plugin-compiler-cli.mjs validate",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "markdown:check": "npm run markdown:format:check && npm run markdown:lint",
    "markdown:format": "prettier --write \"**/*.{md,mdx}\"",
    "markdown:format:check": "prettier --check \"**/*.{md,mdx}\"",
    "markdown:lint": "markdownlint-cli2",
    "markdown:lint:fix": "markdownlint-cli2 --fix"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "string-width": "8.2.1",
    "yaml": "2.9.0"
  }
}
